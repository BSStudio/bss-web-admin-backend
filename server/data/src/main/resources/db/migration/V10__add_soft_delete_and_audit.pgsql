-- squawk-ignore-file prefer-bigint-over-smallint
-- Envers stores revtype as a SMALLINT
-- squawk-ignore-file ban-drop-constraint, require-concurrent-index-creation
-- the unique constraints become partial unique indexes; the tables are small, and CONCURRENTLY can't run in the
-- transaction Flyway runs the migration in

-- soft delete: a deleted row stays, with the time it was deleted
ALTER TABLE video
ADD COLUMN deleted_at TIMESTAMP WITH TIME ZONE;
ALTER TABLE event
ADD COLUMN deleted_at TIMESTAMP WITH TIME ZONE;
ALTER TABLE member
ADD COLUMN deleted_at TIMESTAMP WITH TIME ZONE;

-- titles and urls are unique among the rows that aren't deleted, so a deleted one can be reused
ALTER TABLE video
DROP CONSTRAINT video_title_key;
ALTER TABLE event
DROP CONSTRAINT event_url_key;
ALTER TABLE event
DROP CONSTRAINT event_title_key;
ALTER TABLE member
DROP CONSTRAINT member_url_key;

CREATE UNIQUE INDEX video_title_key ON video (title) WHERE deleted_at IS NULL;
CREATE UNIQUE INDEX event_url_key ON event (url) WHERE deleted_at IS NULL;
CREATE UNIQUE INDEX event_title_key ON event (title) WHERE deleted_at IS NULL;
CREATE UNIQUE INDEX member_url_key ON member (url) WHERE deleted_at IS NULL;

-- Envers: one row per transaction that changed audited rows
CREATE TABLE revinfo
(
    rev BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    timestamp TIMESTAMP WITH TIME ZONE NOT NULL,
    username TEXT
);

-- revtype: 0 created, 1 changed, 2 deleted
CREATE TABLE video_aud
(
    id UUID NOT NULL,
    rev BIGINT NOT NULL REFERENCES revinfo (rev),
    revtype SMALLINT NOT NULL,
    title TEXT,
    description TEXT,
    shooting_date_start DATE,
    shooting_date_end DATE,
    visible BOOLEAN,
    created_at TIMESTAMP WITH TIME ZONE,
    updated_at TIMESTAMP WITH TIME ZONE,
    deleted_at TIMESTAMP WITH TIME ZONE,
    PRIMARY KEY (id, rev)
);

CREATE TABLE video_url_aud
(
    rev BIGINT NOT NULL REFERENCES revinfo (rev),
    revtype SMALLINT NOT NULL,
    video_id UUID NOT NULL,
    url TEXT NOT NULL,
    PRIMARY KEY (rev, video_id, url)
);
CREATE INDEX video_url_aud_video_id_rev_idx ON video_url_aud (video_id, rev);

-- the links to labels; the labels themselves have no history
CREATE TABLE video_label_aud
(
    rev BIGINT NOT NULL REFERENCES revinfo (rev),
    revtype SMALLINT NOT NULL,
    video_id UUID NOT NULL,
    label_id UUID NOT NULL,
    PRIMARY KEY (rev, video_id, label_id)
);
CREATE INDEX video_label_aud_video_id_rev_idx ON video_label_aud (video_id, rev);

CREATE TABLE event_aud
(
    id UUID NOT NULL,
    rev BIGINT NOT NULL REFERENCES revinfo (rev),
    revtype SMALLINT NOT NULL,
    url TEXT,
    title TEXT,
    description TEXT,
    date_from DATE,
    date_to DATE,
    visible BOOLEAN,
    created_at TIMESTAMP WITH TIME ZONE,
    updated_at TIMESTAMP WITH TIME ZONE,
    deleted_at TIMESTAMP WITH TIME ZONE,
    PRIMARY KEY (id, rev)
);

CREATE TABLE member_aud
(
    id UUID NOT NULL,
    rev BIGINT NOT NULL REFERENCES revinfo (rev),
    revtype SMALLINT NOT NULL,
    url TEXT,
    name TEXT,
    nickname TEXT,
    description TEXT,
    joined_at DATE,
    role TEXT,
    status TEXT,
    archived BOOLEAN,
    created_at TIMESTAMP WITH TIME ZONE,
    updated_at TIMESTAMP WITH TIME ZONE,
    deleted_at TIMESTAMP WITH TIME ZONE,
    PRIMARY KEY (id, rev)
);

-- a first revision with the rows as they are now, so the first change after this one can be rolled back too
INSERT INTO revinfo (timestamp, username)
VALUES (now(), 'migration');

INSERT INTO video_aud (
    id, rev, revtype, title, description, shooting_date_start, shooting_date_end, visible,
    created_at, updated_at
)
SELECT
    id,
    (SELECT max(revinfo.rev) FROM revinfo) AS rev,
    0 AS revtype,
    title,
    description,
    shooting_date_start,
    shooting_date_end,
    visible,
    created_at,
    updated_at
FROM video;

INSERT INTO video_url_aud (rev, revtype, video_id, url)
SELECT
    (SELECT max(revinfo.rev) FROM revinfo) AS rev,
    0 AS revtype,
    video_id,
    url
FROM video_url
WHERE video_id IS NOT NULL;

INSERT INTO video_label_aud (rev, revtype, video_id, label_id)
SELECT
    (SELECT max(revinfo.rev) FROM revinfo) AS rev,
    0 AS revtype,
    video_id,
    label_id
FROM video_label;

INSERT INTO event_aud (id, rev, revtype, url, title, description, date_from, date_to, visible, created_at, updated_at)
SELECT
    id,
    (SELECT max(revinfo.rev) FROM revinfo) AS rev,
    0 AS revtype,
    url,
    title,
    description,
    date_from,
    date_to,
    visible,
    created_at,
    updated_at
FROM event;

INSERT INTO member_aud (
    id, rev, revtype, url, name, nickname, description, joined_at, role, status, archived,
    created_at, updated_at
)
SELECT
    id,
    (SELECT max(revinfo.rev) FROM revinfo) AS rev,
    0 AS revtype,
    url,
    name,
    nickname,
    description,
    joined_at,
    role,
    status,
    archived,
    created_at,
    updated_at
FROM member;

-- the public views leave the deleted rows out, and the links to them
CREATE OR REPLACE VIEW public.member AS
SELECT
    id,
    url,
    name,
    nickname,
    description,
    joined_at,
    role,
    status,
    archived,
    created_at,
    updated_at
FROM member
WHERE deleted_at IS NULL;

CREATE OR REPLACE VIEW public.video AS
SELECT
    video.id,
    array_remove(array_agg(video_url.url), NULL) AS urls,
    video.title,
    video.description,
    array_remove(array_agg(label.name), NULL) AS labels,
    video.shooting_date_start,
    video.shooting_date_end,
    video.created_at,
    video.updated_at
FROM video
LEFT JOIN video_url ON video.id = video_url.video_id
LEFT JOIN video_label ON video.id = video_label.video_id
LEFT JOIN label ON video_label.label_id = label.id
WHERE
    video.visible
    AND video.deleted_at IS NULL
GROUP BY video.id;

CREATE OR REPLACE VIEW public.crew AS
SELECT
    crew.video_id,
    crew.member_id,
    crew.position
FROM crew
INNER JOIN video ON crew.video_id = video.id AND video.deleted_at IS NULL
INNER JOIN member ON crew.member_id = member.id AND member.deleted_at IS NULL;

CREATE OR REPLACE VIEW public.event AS
SELECT
    id,
    url,
    title,
    description,
    date_from,
    date_to,
    created_at,
    updated_at
FROM event
WHERE
    visible
    AND deleted_at IS NULL;

CREATE OR REPLACE VIEW public.event_video AS
SELECT
    event_video.event_id,
    event_video.video_id
FROM event_video
INNER JOIN event ON event_video.event_id = event.id AND event.deleted_at IS NULL
INNER JOIN video ON event_video.video_id = video.id AND video.deleted_at IS NULL;
