{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allDigest",
    "security:openssf-scorecard",
    "schedule:automergeWeekends",
    "preview:dockerCompose",
    "preview:dockerVersions",
    "mergeConfidence:all-badges",
    ":timezone(Europe/Dublin)",
    ":automergeDigest",
    ":automergeMinor",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "groupName": "All GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],
      "schedule": ["on friday"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "@carbon/styles, which server/ui downloads from npm",
      "managerFilePatterns": ["/^gradle/libs\\.versions\\.toml$/"],
      "matchStrings": ["carbon-styles = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "@carbon/styles",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Pinned RealFaviconGenerator CLI used to generate admin icons",
      "managerFilePatterns": ["/^tools\\/admin-icons\\/generate-icons\\.sh$/"],
      "matchStrings": ["realfavicon@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "realfavicon",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ]
}
